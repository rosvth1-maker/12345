<Window x:Class="TsmServer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ระบบบริหารจัดการเซิร์ฟเวอร์ TS Dark World — .NET 9"
        Icon="icon.ico"
        Height="790" Width="1220"
        MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D24"
        Foreground="#F8FAFC"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI, Tahoma, Leelawadee UI, Microsoft Sans Serif">
    <Window.Resources>
        <!-- Palette Brushes -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0284C7"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentColor" Color="#38BDF8"/>
        <SolidColorBrush x:Key="DarkBg" Color="#11141A"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#1E232E"/>
        <SolidColorBrush x:Key="InputBg" Color="#2A3241"/>
        <SolidColorBrush x:Key="BorderColor" Color="#4A5568"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CBD5E1"/>

        <!-- Global TextBox Style (100% Crisp White Text & Slate Grey Background) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A3241"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="SelectionBrush" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="0" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4"
                        Background="#2A3241" BorderBrush="#4A5568" BorderThickness="1" />
                <Border Grid.Column="0" Margin="1" Background="#2A3241" CornerRadius="4,0,0,4" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="#374151" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="#1E2430" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="false">
                    <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#888888" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Global ComboBox Style (100% Dark Grey / Slate Background & Ultra-Clear White Text) -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2A3241" />
            <Setter Property="BorderBrush" Value="#4A5568" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}"
                                          Grid.Column="2" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1E2430" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="4" Margin="0,2,0,4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#888888" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ComboBoxItem Style (Slate Grey Background with Crisp White Text in All States) -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#1E2430" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1" BorderBrush="#2D3748"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0369A1" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D3748"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#3E4756"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- ส่วนหัวและปุ่มควบคุมหลัก -->
            <RowDefinition Height="Auto"/> <!-- การ์ดแสดงสถานะและข้อมูลระบบ -->
            <RowDefinition Height="*"/>    <!-- แท็บเนื้อหาเครื่องมือต่างๆ -->
            <RowDefinition Height="Auto"/> <!-- แถบสถานะด้านล่าง -->
        </Grid.RowDefinitions>

        <!-- 1. ส่วนหัวและปุ่มควบคุมหลัก -->
        <Border Grid.Row="0" Background="#13151A" BorderBrush="#333A48" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#222630" CornerRadius="8" Padding="8,6" Margin="0,0,14,0" BorderBrush="#38BDF8" BorderThickness="1">
                        <TextBlock Text="⚔️" FontSize="26" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TS Dark World Server" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border Background="#222630" BorderBrush="#34D399" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ระบบจัดการภาษาไทย 100%" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="โปรแกรมเซิร์ฟเวอร์จำลอง C# .NET 9 • รุ่นพิเศษ TS Dark World" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ปุ่มควบคุมการทำงานของเซิร์ฟเวอร์ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStartServer" Content="▶ เริ่มเปิดเซิร์ฟเวอร์" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,9" Margin="0,0,8,0" Click="BtnStartServer_Click"/>
                    <Button x:Name="BtnStopServer" Content="⏹ หยุดเซิร์ฟเวอร์" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,9" IsEnabled="False" Margin="0,0,8,0" Click="BtnStopServer_Click"/>
                    <Button x:Name="BtnRestartServer" Content="🔄 รีสตาร์ทเซิร์ฟเวอร์" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,9" IsEnabled="False" Click="BtnRestartServer_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. การ์ดแสดงสถานะและข้อมูลระบบ (สบายตา ตัวหนังสือชัดเจน) -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- การ์ด 1: สถานะเซิร์ฟเวอร์ -->
            <Border Grid.Column="0" Background="#222630" BorderBrush="#333A48" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="สถานะเซิร์ฟเวอร์" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtServerStatus" Text="🔴 ปิดทำงานอยู่" FontSize="15" FontWeight="Bold" Foreground="#F87171" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- การ์ด 2: พอร์ตที่ให้บริการ -->
            <Border Grid.Column="1" Background="#222630" BorderBrush="#333A48" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="พอร์ตให้บริการ" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtPort" Text="เกม 6613 | แพตช์ 8443" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- การ์ด 3: จำนวนผู้เล่นออนไลน์ -->
            <Border Grid.Column="2" Background="#222630" BorderBrush="#333A48" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="ผู้เล่นออนไลน์" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtOnlineCount" Text="0 คน" FontSize="15" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- การ์ด 4: ปริมาณแรมที่ใช้ -->
            <Border Grid.Column="3" Background="#222630" BorderBrush="#333A48" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="การใช้หน่วยความจำ (RAM)" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtRamUsage" Text="0.0 MB" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- การ์ด 5: อัตราคูณเซิร์ฟเวอร์ -->
            <Border Grid.Column="4" Background="#222630" BorderBrush="#333A48" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="อัตราคูณในเกม" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtRates" Text="EXP x5 • ดรอป x3" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- การ์ด 6: เวลาเปิดต่อเนื่อง -->
            <Border Grid.Column="5" Background="#222630" BorderBrush="#333A48" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="เวลาเปิดต่อเนื่อง" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtUptime" Text="00:00:00" FontSize="15" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. แท็บเครื่องมือต่างๆ -->
        <TabControl Grid.Row="2" Margin="16,0,16,10" Background="#1A1D24" BorderBrush="#333A48">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#222630"/>
                    <Setter Property="Foreground" Value="#CBD5E1"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="16,9"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#333A48" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#2B303C"/>
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- แท็บ 1: จัดการผู้เล่นออนไลน์ -->
            <TabItem Header="👥 จัดการผู้เล่นออนไลน์">
                <Border Background="#222630" Margin="0,4,0,0" BorderBrush="#333A48" BorderThickness="1" CornerRadius="0,6,6,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- แถบค้นหา -->
                        <Border Grid.Row="0" Background="#1B1E26" BorderBrush="#333A48" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ค้นหาชื่อตัวละคร / ชื่อบัญชี:" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="TxtSearchPlayer" Grid.Column="1" Height="30" VerticalContentAlignment="Center" TextChanged="TxtSearchPlayer_TextChanged"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="🔄 รีเฟรชรายชื่อ" Padding="12,5" Click="BtnRefreshPlayers_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ตารางแสดงรายชื่อผู้เล่น -->
                        <DataGrid x:Name="GridPlayers" Grid.Row="1" Background="#16181E" Foreground="#FFFFFF" RowBackground="#1F232D" AlternatingRowBackground="#262B37"
                                  BorderBrush="#333A48" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333A48" SelectionMode="Single" FontSize="13">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#13151A"/>
                                    <Setter Property="Foreground" Value="#38BDF8"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#333A48"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="รหัสตัวละคร" Binding="{Binding CharacterId}" Width="90"/>
                                <DataGridTextColumn Header="ชื่อบัญชี" Binding="{Binding Account}" Width="120"/>
                                <DataGridTextColumn Header="ชื่อตัวละคร" Binding="{Binding Name}" Width="140"/>
                                <DataGridTextColumn Header="เลเวล" Binding="{Binding Level}" Width="70"/>
                                <DataGridTextColumn Header="ธาตุ" Binding="{Binding ElementStr}" Width="105"/>
                                <DataGridTextColumn Header="รหัสแผนที่" Binding="{Binding MapId}" Width="90"/>
                                <DataGridTextColumn Header="พิกัด (X, Y)" Binding="{Binding PositionStr}" Width="110"/>
                                <DataGridTextColumn Header="พลังชีวิต / มานา (HP/SP)" Binding="{Binding HpSpStr}" Width="150"/>
                                <DataGridTextColumn Header="เงินในตัว (ทอง)" Binding="{Binding Gold, StringFormat={}{0:N0}}" Width="125"/>
                                <DataGridTextColumn Header="ระดับ GM" Binding="{Binding GmLevel}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- แผงเครื่องมือจัดการตัวละครที่เลือก -->
                        <Border Grid.Row="2" Background="#1B1E26" BorderBrush="#333A48" BorderThickness="0,1,0,0" Padding="14,12">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="จัดการตัวละครที่เลือก:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,12,0"/>
                                <Button Content="👢 เตะออกจากเซิร์ฟเวอร์" Background="#7F1D1D" Foreground="#FCA5A5" Margin="0,0,6,0" Click="BtnKickPlayer_Click"/>
                                <Button Content="💰 แจก 1,000,000 ทอง" Margin="0,0,6,0" Click="BtnAddGoldPlayer_Click"/>
                                <Button Content="🌀 วาร์ปกลับเมืองเริ่มต้น" Margin="0,0,6,0" Click="BtnWarpPlayer_Click"/>
                                <Button Content="⬆️ ปรับเป็นเลเวล 100" Margin="0,0,6,0" Click="BtnSetLevelPlayer_Click"/>
                                <Button Content="🎁 แจกชุดอุปกรณ์เริ่มต้น" Margin="0,0,6,0" Click="BtnGiveStarterKit_Click"/>
                                <Button Content="💬 ส่งข้อความกระซิบหาผู้เล่น" Margin="0,0,6,0" Click="BtnWhisperPlayer_Click"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- แท็บ 2: คลังข้อมูลไอเทมและขุนพล -->
            <!-- แท็บ 2: คลังข้อมูลไอเทม ขุนพล และไฟล์เกม (Game Data Explorer) -->
            <TabItem Header="📦 คลังข้อมูลเกม (Item, NPC &amp; Data Files)">
                <Border Background="#222630" Margin="0,4,0,0" BorderBrush="#333A48" BorderThickness="1" CornerRadius="0,6,6,6">
                    <TabControl Background="#1E232E" BorderBrush="#333A48" Margin="8">

                        <!-- 2.1 คลังไอเทม (Item Data) -->
                        <TabItem Header="🎒 คลังข้อมูลไอเทม (Item Data)">
                            <Border Background="#1E232E" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

