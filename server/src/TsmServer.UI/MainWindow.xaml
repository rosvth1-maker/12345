            </TabItem>

            <!-- แท็บ 4: จัดการบัญชีผู้เล่น -->
            <TabItem Header="👤 จัดการบัญชีผู้เล่น">
                <Border Background="#222630" Margin="0,4,0,0" Padding="16" BorderBrush="#333A48" BorderThickness="1" CornerRadius="0,6,6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- แบบฟอร์มสร้างบัญชี -->
                        <GroupBox Header="➕ สร้างบัญชีใหม่ / แก้ไขรหัสผ่าน" Margin="0,0,14,0">
                            <Border Padding="12">
                                <StackPanel>
                                    <TextBlock Text="ชื่อบัญชี (Username):" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNewAccount" Text="player1" Height="30" Margin="0,0,0,10"/>

                                    <TextBlock Text="รหัสผ่าน (Password):" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtNewPassword" Height="30" Margin="0,0,0,10"/>

                                    <TextBlock Text="ระดับสิทธิ์ (GM Level):" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbNewGmLevel" SelectedIndex="0" Margin="0,0,0,16">
                                        <ComboBoxItem Content="0 - ผู้เล่นทั่วไป (Regular Player)"/>
                                        <ComboBoxItem Content="5 - ผู้ดูแลระบบ (Game Master)"/>
                                        <ComboBoxItem Content="10 - ผู้ดูแลสูงสุด (Super Admin)"/>
                                    </ComboBox>

                                    <Button Content="💾 บันทึก / สร้างบัญชีผู้ใช้" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Height="34" Click="BtnCreateAccount_Click"/>
                                </StackPanel>
                            </Border>
                        </GroupBox>

                        <!-- เครื่องมือช่วยเหลือตัวละคร -->
                        <GroupBox Grid.Column="1" Header="🛠️ เครื่องมือช่วยเหลือและแก้ไขตัวละคร">
                            <Border Padding="12">
                                <StackPanel>
                                    <TextBlock Text="แก้ปัญหาตัวละครติดแมพ (Unstuck Player):" FontWeight="Bold" Foreground="#F8FAFC" FontSize="14" Margin="0,0,0,6"/>
                                    <TextBlock Text="หากผู้เล่นติดบั๊กในแผนที่หรือเข้าเกมไม่ได้ ให้ระบุรหัสตัวละครเพื่อรีเซ็ตพิกัดกลับสู่เมืองเริ่มต้น" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBox x:Name="TxtUnstuckCharId" Text="1" Width="120" Height="30" Margin="0,0,10,0"/>
                                        <Button Content="🌀 รีเซ็ตพิกัดตัวละครกลับเมืองเริ่มต้น" Click="BtnUnstuckChar_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </GroupBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- แท็บ 5: บันทึกการทำงานของเซิร์ฟเวอร์ -->
            <TabItem Header="📜 บันทึกระบบ (Logs)">
                <Border Background="#222630" Margin="0,4,0,0" BorderBrush="#333A48" BorderThickness="1" CornerRadius="0,6,6,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- แถบควบคุม Log -->
                        <Border Grid.Row="0" Background="#1B1E26" BorderBrush="#333A48" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ระดับการแสดงผล:" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbLogLevel" SelectedIndex="0" Width="130" Margin="0,0,12,0">
                                        <ComboBoxItem Content="ทั้งหมด (All)"/>
                                        <ComboBoxItem Content="ข้อมูลทั่วไป (Info)"/>
                                        <ComboBoxItem Content="คำสั่ง GM"/>
                                        <ComboBoxItem Content="แพ็กเก็ต (Packets)"/>
                                        <ComboBoxItem Content="ข้อผิดพลาด (Error)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <CheckBox x:Name="ChkAutoScroll" Content="เลื่อนหน้าจออัตโนมัติ" IsChecked="True" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="💾 ส่งออกไฟล์บันทึก (.txt)" Margin="0,0,6,0" Click="BtnExportLogs_Click"/>
                                    <Button Content="🧹 ล้างหน้าจอบันทึก" Click="BtnClearLogs_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBox x:Name="TxtLogs" Grid.Row="1" Background="#0F1117" Foreground="#34D399" FontFamily="Consolas, Cascadia Code, Tahoma"
                                 FontSize="12.5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" Margin="0"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- แท็บ 6: ตั้งค่าเซิร์ฟเวอร์ & Config.JSON -->
            <TabItem Header="⚙️ ตั้งค่าเซิร์ฟเวอร์ &amp; Config.JSON">
                <Border Background="#222630" Margin="0,4,0,0" Padding="14" BorderBrush="#333A48" BorderThickness="1" CornerRadius="0,6,6,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ฝั่งซ้าย: ฟอร์มกรอกและปรับแต่ง Config -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                            <StackPanel>
                                <!-- โหมดไอพีและการเชื่อมต่อ -->
                                <GroupBox Header="🌐 โหมดไอพีเซิร์ฟเวอร์ (Localhost 127.0.0.1 / VPS Server)" Margin="0,0,0,10">
                                    <Border Padding="10">
                                        <StackPanel>
                                            <RadioButton x:Name="RbLocalMode" Content="🏠 โหมดเล่นคนเดียวในเครื่อง (Localhost: 127.0.0.1)" IsChecked="True" Foreground="#34D399" FontWeight="SemiBold" Margin="0,0,0,6" Checked="RbIpMode_Changed"/>
                                            <RadioButton x:Name="RbVpsMode" Content="☁️ โหมดออนไลน์บน VPS / Dedicated Server" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,10" Checked="RbIpMode_Changed"/>

                                            <TextBlock Text="ไอพีเซิร์ฟเวอร์ VPS (Public IP / Domain):" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CfgVpsIp" Text="127.0.0.1" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="🌐 ตรวจสอบไอพี" Padding="8,3" Click="BtnDetectPublicIp_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="พอร์ตเกม TCP:" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="CfgPort" Text="6613" Height="28"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                    <TextBlock Text="Bind IP:" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="CfgHost" Text="127.0.0.1" Height="28"/>
                                                </StackPanel>
                                            </Grid>

                                            <Button Content="📋 สร้างไฟล์เชื่อมต่อสำหรับผู้เล่น (Client Config)" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Height="30" Click="BtnGenerateClientConfig_Click"/>
                                        </StackPanel>
                                    </Border>
                                </GroupBox>

                                <!-- ฐานข้อมูล MySQL (XAMPP) -->
                                <GroupBox Header="🗄️ ฐานข้อมูล MySQL (XAMPP พอร์ต 3306)" Margin="0,0,0,10">
                                    <Border Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="สตริงเชื่อมต่อฐานข้อมูล MySQL (Connection String):" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox x:Name="CfgDbConn" Text="Server=localhost;Port=3306;Database=tsm_dodo;Uid=root;Pwd=;" Height="28" Margin="0,0,0,8"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button Content="🔌 ทดสอบเชื่อมต่อ MySQL" Margin="0,0,6,0" Click="BtnTestDb_Click"/>
                                                <Button Content="🛠️ สร้างตาราง SQL" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,6,0" Click="BtnInitDb_Click"/>
                                                <Button Content="💾 แบ็กอัป SQL" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,6,0" Click="BtnBackupDb_Click"/>
                                                <Button Content="📂 โฟลเดอร์ Backup" Click="BtnOpenBackupDir_Click"/>
                                            </StackPanel>

                                            <Border Background="#1B1E26" BorderBrush="#333A48" BorderThickness="1" CornerRadius="4" Padding="8,5">
                                                <CheckBox x:Name="ChkAutoBackup" Content="⚡ สำรองข้อมูล SQL อัตโนมัติลง SQL\Backups เมื่อแก้ไข" IsChecked="True" Foreground="#34D399" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </GroupBox>

                                <!-- อัตราคูณและที่อยู่ข้อมูลเกม -->
                                <GroupBox Header="🎮 อัตราคูณเซิร์ฟเวอร์ &amp; โฟลเดอร์ข้อมูล" Margin="0,0,0,10">
                                    <Border Padding="10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,3,0">
                                                    <TextBlock Text="EXP:" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="CfgExpRate" Text="1" Height="28"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                    <TextBlock Text="ดรอป:" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="CfgDropRate" Text="1" Height="28"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="3,0,3,0">
                                                    <TextBlock Text="เงินทอง:" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="CfgGoldRate" Text="1" Height="28"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="3,0,0,0">
                                                    <TextBlock Text="EXP ขุนพล:" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="CfgPetExpRate" Text="1" Height="28"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="โฟลเดอร์เก็บข้อมูลเกมภาษาไทย (Data Path):" Foreground="#CBD5E1" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox x:Name="CfgDataPath" Text="DATA\Data" Height="28" Margin="0,0,0,8"/>

                                            <Button Content="💾 บันทึกฟอร์มลง Config.JSON และปรับใช้ทันที" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Height="32" Click="BtnSaveConfig_Click"/>
                                        </StackPanel>
                                    </Border>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ฝั่งขวา: โปรแกรมแก้ไขไฟล์ Config.JSON โดยตรง (Live Visual Code Editor) -->
                        <GroupBox Grid.Column="1" Header="📄 ปรับแต่งไฟล์ Config.JSON โดยตรง (Live Editor)" Margin="0,0,0,0">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- แถบเครื่องมือจัดการ JSON -->
                                <Border Grid.Row="0" Background="#16181E" BorderBrush="#333A48" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                    <WrapPanel>
                                        <Button Content="🔄 โหลดจากไฟล์" Margin="0,0,6,0" Click="BtnReloadConfig_Click"/>
                                        <Button Content="💾 บันทึกไฟล์ JSON" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,6,0" Click="BtnSaveJsonEditor_Click"/>
                                        <Button Content="🔄 คืนค่าเริ่มต้น" Margin="0,0,6,0" Click="BtnResetDefaultConfig_Click"/>
                                        <Button Content="📂 เปิดโฟลเดอร์" Click="BtnOpenConfigDir_Click"/>
                                    </WrapPanel>
                                </Border>

                                <!-- กล่องข้อความโค้ด JSON -->
                                <TextBox x:Name="TxtConfigJson" Grid.Row="1" Background="#0F1117" Foreground="#38BDF8"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12.5"
                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10"/>

                                <!-- สถานะที่อยู่ไฟล์ Config -->
                                <TextBlock x:Name="TxtConfigPathDisplay" Grid.Row="2" Text="📁 ตำแหน่งไฟล์: DATA\Config.JSON" FontSize="11.5" Foreground="#94A3B8" Margin="4,6,0,0"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 4. แถบสถานะด้านล่าง -->
        <Border Grid.Row="3" Background="#13151A" BorderBrush="#333A48" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <TextBlock x:Name="TxtFooterStatus" Text="โปรแกรมจำลองเซิร์ฟเวอร์ TS Dark World • พร้อมให้บริการ" FontSize="12.5" Foreground="#94A3B8"/>
                <TextBlock Text="TS Dark World • C# 13 • .NET 9.0 Windows x64" FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
