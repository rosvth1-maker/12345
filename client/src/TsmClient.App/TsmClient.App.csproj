<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TS Dark World</AssemblyName>
    <RootNamespace>TsmClient.App</RootNamespace>
    <Version>0.8.0-test.1</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.1</FileVersion>
    <InformationalVersion>0.8.0-test.1+20260817.035558</InformationalVersion>
    <Product>TS Dark World Windows Client</Product>
    <Description>TS Dark World Phase 8A unified local test client</Description>
