  <ItemGroup>
    <ProjectReference Include="..\TsmClient.Data\TsmClient.Data.csproj" />
    <ProjectReference Include="..\TsmClient.Domain\TsmClient.Domain.csproj" />
    <ProjectReference Include="..\TsmClient.GameLogic\TsmClient.GameLogic.csproj" />
    <ProjectReference Include="..\TsmClient.Network\TsmClient.Network.csproj" />
